#!/usr/bin/env bash

set -euo pipefail

CMD="baidupcs"
STATE_DIR=".baidusync"
PATH_FILE="$STATE_DIR/path"
LOCAL_FILE="$STATE_DIR/local"
REMOTE_FILE="$STATE_DIR/remote"

if ! command -v "$CMD" >/dev/null 2>&1; then
    echo "Error: $CMD not found."
    exit 1
fi

mkdir -p "$STATE_DIR"

show_help() {
    cat <<EOF
Usage: $(basename "$0") <command> [args]

Dependency: baidupcs-go

Commands:
  help              show help
  init <remote-dir> associate current dir with remote dir
  commit            refresh local and remote file lists
  diff              show differences between local and remote
  push              upload local-only files to remote
  pull              download remote-only files to local
  sync              push + pull
EOF
}

get_remote_list() {
    local remote_dir
    remote_dir=$(cat "$PATH_FILE")
    "$CMD" ls "$remote_dir" | awk '{print $NF}' | sort
}

get_local_list() {
    find . -maxdepth 1 -type f ! -name '.*' -printf '%f\n' | sort
}

save_remote() {
    get_remote_list >"$REMOTE_FILE"
}

save_local() {
    get_local_list >"$LOCAL_FILE"
}

case "${1:-}" in
help)
    show_help
    exit 0
    ;;
init)
    if [ -z "${2:-}" ]; then
        echo "Error: remote directory path required."
        exit 1
    fi
    echo "$2" >"$PATH_FILE"
    save_remote
    save_local
    echo "Initialized: local dir <-> $2"
    ;;
commit)
    if [ ! -f "$PATH_FILE" ]; then
        echo "Error: not initialized. Run '$(basename "$0") init <remote-dir>' first."
        exit 1
    fi
    save_remote
    save_local
    echo "Committed: local and remote lists updated."
    ;;
diff)
    if [ ! -f "$LOCAL_FILE" ] || [ ! -f "$REMOTE_FILE" ]; then
        echo "Error: no snapshot. Run '$(basename "$0") commit' first."
        exit 1
    fi
    echo "***** Remote only *****"
    comm -13 "$LOCAL_FILE" "$REMOTE_FILE"
    echo "***** Local only *****"
    comm -23 "$LOCAL_FILE" "$REMOTE_FILE"
    ;;
push)
    if [ ! -f "$LOCAL_FILE" ] || [ ! -f "$REMOTE_FILE" ]; then
        echo "Error: no snapshot. Run '$(basename "$0") commit' first."
        exit 1
    fi
    remote_dir=$(cat "$PATH_FILE")
    while IFS= read -r file; do
        echo "Uploading: $file"
        "$CMD" upload "$file" "$remote_dir"
    done < <(comm -23 "$LOCAL_FILE" "$REMOTE_FILE")
    save_remote
    ;;
pull)
    if [ ! -f "$LOCAL_FILE" ] || [ ! -f "$REMOTE_FILE" ]; then
        echo "Error: no snapshot. Run '$(basename "$0") commit' first."
        exit 1
    fi
    remote_dir=$(cat "$PATH_FILE")
    while IFS= read -r file; do
        echo "Downloading: $file"
        "$CMD" download -saveto "$(pwd)/" "$remote_dir/$file"
    done < <(comm -13 "$LOCAL_FILE" "$REMOTE_FILE")
    save_local
    ;;
sync)
    if [ ! -f "$LOCAL_FILE" ] || [ ! -f "$REMOTE_FILE" ]; then
        echo "Error: no snapshot. Run '$(basename "$0") commit' first."
        exit 1
    fi
    remote_dir=$(cat "$PATH_FILE")
    while IFS= read -r file; do
        echo "Uploading: $file"
        "$CMD" upload "$file" "$remote_dir"
    done < <(comm -23 "$LOCAL_FILE" "$REMOTE_FILE")
    while IFS= read -r file; do
        echo "Downloading: $file"
        "$CMD" download -saveto "$(pwd)/" "$remote_dir/$file"
    done < <(comm -13 "$LOCAL_FILE" "$REMOTE_FILE")
    save_remote
    save_local
    echo "Sync done."
    ;;
*)
    echo "Error: unknown command '${1:-}'."
    show_help
    exit 1
    ;;
esac
