#!/usr/bin/env bash

set -euo pipefail

VERSION="v261006"

show_help() {
    cat <<EOF
Usage: $(basename "$0") [options]

Dependency: pdftk or ghostscript (gs)

Options:
  -h, --help               show help
  -v, --version            show version
  -b, --bin    <pdftk|gs>  use pdftk if not specified
  -i, --input  <file>      input PDF file, one or more after -i
  -o, --output <file>      output PDF file, default: merge.pdf

Example:
  $(basename "$0") -i 1.pdf 2.pdf 3.pdf -o out.pdf
  $(basename "$0") -i 1.pdf -i 2.pdf -i 3.pdf -o out.pdf -b gs
EOF
}

show_version() {
    echo "$(basename "$0") ${VERSION}, depending on pdftk or ghostscript"
}

bin="pdftk"
input_files=()
output=""

n=1
while [ "$n" -le "$#" ]; do
    arg="${!n}"
    case "$arg" in
    -h | --help)
        show_help
        exit 0
        ;;
    -v | --version)
        show_version
        exit 0
        ;;
    -b | --bin)
        next=$((n + 1))
        if [ "$next" -gt "$#" ]; then
            echo "Error: -b/--bin requires pdftk or gs."
            exit 1
        fi
        bin="${!next}"
        n=$((next + 1))
        ;;
    -i | --input)
        next=$((n + 1))
        if [ "$next" -gt "$#" ]; then
            echo "Error: -i/--input requires at least one file."
            exit 1
        fi
        while [ "$next" -le "$#" ]; do
            next_arg="${!next}"
            case "$next_arg" in
            -*)
                break
                ;;
            *)
                input_files+=("$next_arg")
                next=$((next + 1))
                ;;
            esac
        done
        n="$next"
        ;;
    -o | --output)
        next=$((n + 1))
        if [ "$next" -gt "$#" ]; then
            echo "Error: -o/--output requires a file path."
            exit 1
        fi
        output="${!next}"
        n=$((next + 1))
        ;;
    *)
        echo "Error: unknown option '$arg'."
        show_help
        exit 1
        ;;
    esac
done

if [ "${#input_files[@]}" -eq 0 ]; then
    echo "Error: no input file specified."
    show_help
    exit 1
fi

if [[ -z "$output" ]]; then
    output="merge.pdf"
fi

case "$bin" in
pdftk | gs) ;;
*)
    echo "Error: invalid backend '$bin'."
    echo "Allowed values: pdftk, gs"
    exit 1
    ;;
esac

for f in "${input_files[@]}"; do
    if [[ -z "$f" ]]; then
        echo "Error: input file not found: $f"
        exit 1
    fi
done

case "$bin" in
pdftk)
    pdftk "${input_files[@]}" cat output "$output"
    ;;
gs)
    gs -dBATCH -dNOPAUSE -q -sDEVICE=pdfwrite -sOutputFile="$output" "${input_files[@]}"
    ;;
esac

echo "Merged: $output (files: ${#input_files[@]})"
