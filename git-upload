#!/usr/bin/env bash

set -euo pipefail

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then # 检查是否在 git 仓库中
    echo "Error: not a git repository."
    exit 1
fi

if git diff --quiet && git diff --cached --quiet; then # 检查是否有变更
    echo "No changes to commit."
    exit 0
fi

if [ -z "${1:-}" ]; then # 检查提交信息
    echo "Error: commit message is required."
    echo "Usage: $(basename "$0") <message> [hub|ee|both]"
    exit 1
fi

branch=$(git rev-parse --abbrev-ref HEAD) # 检测当前分支
git add -A
git commit -m "$1"
target="${2:-both}"

case "$target" in
hub)
    echo "Pushing to GitHub ($branch)..."
    git push github "$branch"
    ;;
ee)
    echo "Pushing to Gitee ($branch)..."
    git push gitee "$branch"
    ;;
both)
    echo "Pushing to GitHub ($branch)..."
    git push github "$branch"
    echo "Pushing to Gitee ($branch)..."
    git push gitee "$branch"
    ;;
*)
    echo "Error: 2nd param must be [hub|ee|both]."
    echo "Usage: $(basename "$0") <message> [hub|ee|both]"
    exit 1
    ;;
esac

echo "Done."
