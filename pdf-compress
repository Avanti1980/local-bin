#!/usr/bin/env bash

set -euo pipefail

VERSION="v261006"

show_help() {
    cat <<EOF
Usage: $(basename "$0") [options]

Dependency: ps2pdf (ghostscript)

Options:
  -h, --help                show help
  -v, --version             show version
  -c, --compress <quality>  screen | ebook | printer | prepress (default: prepress)
  -i, --input    <file>     input PDF file (required)
  -o, --output   <file>     output PDF file (default: <input>, compressed.pdf)

Example:
  $(basename "$0") -c ebook -i input.pdf -o output.pdf
EOF
}

show_version() {
    echo "$(basename "$0") ${VERSION}, depending on ps2pdf"
}

compress="prepress"
input=""
output=""

while [[ $# -gt 0 ]]; do
    case "$1" in
    -h | --help)
        show_help
        exit 0
        ;;
    -v | --version)
        show_version
        exit 0
        ;;
    -c | --compress)
        [[ -z "${2:-}" ]] && {
            echo "Error: -c/--compress requires a quality value."
            exit 1
        }
        compress="$2"
        shift 2
        ;;
    -i | --input)
        [[ -z "${2:-}" ]] && {
            echo "Error: -i/--input requires a file path."
            exit 1
        }
        input="$2"
        shift 2
        ;;
    -o | --output)
        [[ -z "${2:-}" ]] && {
            echo "Error: -o/--output requires a file path."
            exit 1
        }
        output="$2"
        shift 2
        ;;
    *)
        echo "Error: unknown option '$1'."
        show_help
        exit 1
        ;;
    esac
done

if [[ -z "$input" ]]; then
    echo "Error: no input file specified."
    show_help
    exit 1
fi

if [[ ! -f "$input" ]]; then
    echo "Error: input file not found: $input"
    exit 1
fi

if [[ -z "$output" ]]; then
    base="${input%.*}"
    output="${base}, compressed.pdf"
fi

if [[ "$input" == "$output" ]]; then
    echo "Error: output file would overwrite input file."
    exit 1
fi

case "$compress" in
screen | ebook | printer | prepress) ;;
*)
    echo "Error: invalid compress quality '$compress'."
    echo "Allowed values: screen, ebook, printer, prepress"
    exit 1
    ;;
esac

ps2pdf -dPDFSETTINGS="/${compress}" "$input" "$output"

echo "Compressed: $output (quality: ${compress})"
