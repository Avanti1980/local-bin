#!/usr/bin/env bash

set -euo pipefail

VERSION="v261007"

show_help() {
    cat <<EOF
Usage: $(basename "$0") [options]

Dependencies: ImageMagick (magick)

Options:
  -h, --help                 show help
  -v, --version              show version
  -d, --direction <h|v>      h for horizontal, v for vertical (default: h)
  -i, --input     <file...>  input images, one or more after -i
  -o, --output    <file>     output image, default: merge.jpg

Example:
  $(basename "$0") -d v -i 1.jpg 2.png 3.jpeg -o out.jpg
  $(basename "$0") -i 1.jpg -i 2.png -o out.jpg -d h
EOF
}

show_version() {
    echo "$(basename "$0") ${VERSION}, depending on ImageMagick"
}

direction="h"
input_files=()
output=""

n=1
while [ "$n" -le "$#" ]; do
    arg="${!n}"
    case "$arg" in
    -h | --help)
        show_help
        exit 0
        ;;
    -v | --version)
        show_version
        exit 0
        ;;
    -d | --direction)
        next=$((n + 1))
        if [ "$next" -gt "$#" ]; then
            echo "Error: -d/--direction requires h or v."
            exit 1
        fi
        direction="${!next}"
        n=$((next + 1))
        ;;
    -i | --input)
        next=$((n + 1))
        if [ "$next" -gt "$#" ]; then
            echo "Error: -i/--input requires at least one file."
            exit 1
        fi
        while [ "$next" -le "$#" ]; do
            next_arg="${!next}"
            case "$next_arg" in
            -*)
                break
                ;;
            *)
                input_files+=("$next_arg")
                next=$((next + 1))
                ;;
            esac
        done
        n="$next"
        ;;
    -o | --output)
        next=$((n + 1))
        if [ "$next" -gt "$#" ]; then
            echo "Error: -o/--output requires a file path."
            exit 1
        fi
        output="${!next}"
        n=$((next + 1))
        ;;
    *)
        echo "Error: unknown option '$arg'."
        show_help
        exit 1
        ;;
    esac
done

if [ "${#input_files[@]}" -eq 0 ]; then
    echo "Error: no input file specified."
    show_help
    exit 1
fi

if [ -z "$output" ]; then
    output="merge.jpg"
fi

case "$direction" in
h) append_flag="+append" ;;
v) append_flag="-append" ;;
*)
    echo "Error: invalid direction '$direction'."
    echo "Allowed values: h, v"
    exit 1
    ;;
esac

for f in "${input_files[@]}"; do
    if [ ! -f "$f" ]; then
        echo "Error: input file not found: $f"
        exit 1
    fi
done

magick "${input_files[@]}" $append_flag -quality 100 -auto-orient "$output"

echo "Merged: $output (direction: ${direction})"
