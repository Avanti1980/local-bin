#!/usr/bin/env bash

set -euo pipefail

if ! command -v xrandr >/dev/null 2>&1; then
    echo "Error: xrandr not found."
    exit 1
fi

direction="${1:-}"

case "$direction" in
r | l | t | b) ;;
*)
    echo "Usage: $(basename "$0") <r|l|t|b>"
    echo "  r: extend to the right"
    echo "  l: extend to the left"
    echo "  t: extend to the top"
    echo "  b: extend to the bottom"
    exit 1
    ;;
esac

primary_output=$(xrandr | grep " connected primary " | head -n1 | awk '{print $1}')

if [ -z "$primary_output" ]; then
    echo "Error: no primary output found."
    exit 1
fi

secondary_output=""

while IFS= read -r line; do
    output_name=$(echo "$line" | awk '{print $1}')
    if [ "$output_name" != "$primary_output" ]; then
        secondary_output="$output_name"
        break
    fi
done < <(xrandr | grep " connected ")

if [ -z "$secondary_output" ]; then
    echo "Error: no secondary connected output found."
    exit 1
fi

case "$direction" in
r)
    xrandr --output "$secondary_output" --auto --right-of "$primary_output"
    ;;
l)
    xrandr --output "$secondary_output" --auto --left-of "$primary_output"
    ;;
t)
    xrandr --output "$secondary_output" --auto --above "$primary_output"
    ;;
b)
    xrandr --output "$secondary_output" --auto --below "$primary_output"
    ;;
esac

echo "Extended: $secondary_output ${direction} of $primary_output"
